[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = delta
    autocrlf = input

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = "TwoDark"

[alias]
    s = status -sb
    l = log --oneline --graph -20
    d = diff
    co = checkout
    br = branch
    cm = commit -m
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    wip = !git add -A && git commit -m 'wip'
